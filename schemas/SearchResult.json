{
  "$defs": {
    "Product": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "price_kopecks": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Kopecks"
        },
        "license_units": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Units"
        },
        "in_stock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Stock"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "category_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Id"
        },
        "category_ids": {
          "items": {
            "type": "string"
          },
          "title": "Category Ids",
          "type": "array"
        },
        "category_path": {
          "items": {
            "type": "string"
          },
          "title": "Category Path",
          "type": "array"
        },
        "family_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Id"
        },
        "family_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Name"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "search_text": {
          "default": "",
          "title": "Search Text",
          "type": "string"
        },
        "os": {
          "items": {
            "type": "string"
          },
          "title": "Os",
          "type": "array"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "license_unit_type": {
          "anyOf": [
            {
              "enum": [
                "device",
                "user",
                "license"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Unit Type"
        },
        "min_purchase": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Purchase"
        },
        "license_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Type"
        },
        "product_type": {
          "default": "unknown",
          "enum": [
            "software",
            "hardware",
            "unknown"
          ],
          "title": "Product Type",
          "type": "string"
        },
        "source_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Currency"
        },
        "source_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Date"
        },
        "data_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Data Warnings",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "title",
        "category"
      ],
      "title": "Product",
      "type": "object"
    },
    "SearchHit": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "$ref": "#/$defs/Product"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "branch_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Branch Scores",
          "type": "object"
        }
      },
      "required": [
        "product",
        "rank"
      ],
      "title": "SearchHit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hits": {
      "items": {
        "$ref": "#/$defs/SearchHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "empty",
        "partial",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    }
  },
  "title": "SearchResult",
  "type": "object"
}