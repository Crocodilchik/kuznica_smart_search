{
  "$defs": {
    "HardFilters": {
      "additionalProperties": false,
      "properties": {
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "devices": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Devices"
        },
        "max_total_price_kopecks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Price Kopecks"
        },
        "budget_scope": {
          "anyOf": [
            {
              "enum": [
                "primary",
                "bundle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Scope"
        },
        "in_stock": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Stock"
        }
      },
      "title": "HardFilters",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "preferred_brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Brand"
        },
        "target_price_kopecks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Price Kopecks"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "QuerySpec": {
      "additionalProperties": false,
      "properties": {
        "raw_query": {
          "title": "Raw Query",
          "type": "string"
        },
        "normalized_query": {
          "title": "Normalized Query",
          "type": "string"
        },
        "intent": {
          "default": "product_search",
          "enum": [
            "exact_product",
            "product_search",
            "alternatives",
            "complements",
            "solution"
          ],
          "title": "Intent",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "category_hints": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Category Hints",
          "type": "array"
        },
        "hard_filters": {
          "$ref": "#/$defs/HardFilters"
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        },
        "clarifying_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarifying Question"
        }
      },
      "required": [
        "raw_query",
        "normalized_query"
      ],
      "title": "QuerySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query_spec": {
      "$ref": "#/$defs/QuerySpec"
    },
    "mode": {
      "default": "bm25",
      "enum": [
        "sku",
        "bm25",
        "dense",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "top_k": {
      "default": 10,
      "maximum": 1000,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    }
  },
  "required": [
    "query_spec"
  ],
  "title": "SearchParams",
  "type": "object"
}