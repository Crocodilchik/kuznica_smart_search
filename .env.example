# Local application, relative catalog paths use the repository root
SMART_SEARCH_MODE=prod
SMART_SEARCH_BACKEND_MODULE=smart_search.backend
# Leave empty for standalone Streamlit. Set to http://127.0.0.1:8000 with a running API.
SMART_SEARCH_API_URL=

# Model shared by query understanding, recommendation planning and evidence checks
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5
LLM_TEMPERATURE=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
SMART_SEARCH_RECOMMENDATION_PLANNER=llm

# Full catalog and published index. Empty URL uses local single-process Qdrant.
SOFTLINE_CATALOG_DIR=data/catalog
SOFTLINE_INDEX_DIR=data/qdrant
SMART_SEARCH_RETRIEVAL_MODE=bm25
QDRANT_URL=
QDRANT_API_KEY=
# If enabling dense retrieval, use the same FastEmbed model when indexing and searching.
SOFTLINE_DENSE_MODEL=

# Production analytics. Specify your broker address and create the topic before use.
SMART_SEARCH_KAFKA_BOOTSTRAP_SERVERS=
SMART_SEARCH_KAFKA_TOPIC=smart-search.search-events.v1
SMART_SEARCH_KAFKA_DELIVERY_TIMEOUT_MS=1000
SMART_SEARCH_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
SMART_SEARCH_KAFKA_SASL_USERNAME=
SMART_SEARCH_KAFKA_SASL_PASSWORD=
