# Select exactly one provider. There is no automatic failover.
LLM_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=5
LLM_TEMPERATURE=0

# Required only when LLM_PROVIDER=deepseek. Keep the real key in your local .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama must be running locally and the configured model must be available there.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
